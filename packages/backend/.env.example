# Copy to .env and adjust. `.env` is gitignored at the repo root.
#
# Every one of these is validated by src/platform/config/env.ts at boot.
# A missing or malformed value kills the process immediately — that is
# deliberate. See the ADR on fail-fast configuration.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Matches docker-compose.yml.
DATABASE_URL=postgresql://quickcommerce:quickcommerce@localhost:5432/quickcommerce

# Connections are OS processes on the Postgres side, not cheap sockets.
# Rule of thumb: instances * DATABASE_POOL_MAX must stay well under the
# server's max_connections (default 100).
DATABASE_POOL_MAX=10

# Host port 6380 — see docker-compose.yml, 6379 is taken by another project.
REDIS_URL=redis://localhost:6380

# CHANGE THESE. Generate with: openssl rand -base64 48
# There is deliberately no default in code — a fallback secret is how a dev
# key ends up signing production tokens.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32chars

# Short access token, long refresh token. The access token cannot be revoked,
# so its lifetime is your worst-case exposure window after a logout.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# How long a stock reservation is held before the sweeper releases it.
# Too short: users lose their cart mid-checkout. Too long: abandoned carts
# starve real buyers of stock.
RESERVATION_TTL_SECONDS=900
