{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "kysely migrate latest",
    "db:rollback": "kysely migrate down",
    "db:codegen": "kysely-codegen --out-file src/platform/db/generated.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.12",
    "argon2": "^0.45.1",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.4",
    "eslint": "^9.39.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.7",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
